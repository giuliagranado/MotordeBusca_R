<<dados, include=FALSE>>=
# =========================================================================
#  TROQUE SOMENTE ESTE BLOCO. O resto do documento se ajusta sozinho.
# =========================================================================
# Os dois arquivos que a Parte D da Aula 01 salvou (caminho relativo a
# consolidados/, onde este .Rnw fica):
# docs   <- read.csv("wikipedia_cidades.csv", stringsAsFactors = FALSE, fileEncoding = "UTF-8")[,4]
# origem <- c("Santos","São Vicente (São Paulo")
# minimo <- 200          # o limiar de nchar usado no coletar.R

# Enquanto voces nao trocarem, o modelo compila com o corpus de teste da
# aula (8 documentos) e imprime um aviso em vermelho no topo.
docs <- read.csv("wikipedia_cidades.csv", stringsAsFactors = FALSE, fileEncoding = "UTF-8")[,4]
origem <- read.csv("wikipedia_cidades.csv", stringsAsFactors = FALSE, fileEncoding = "UTF-8")[,2]
minimo <- 200
corpus_de_teste <- FALSE
# =========================================================================

# REGRA: nada de acento dentro de string de R -- o acento quebra quando a
# sessao do R nao esta em locale UTF-8. Onde precisar, escreva o acento em
# LaTeX ("m\\'edia"): o \Sexpr repassa intacto.

# Texto que vem do corpus entra no LaTeX com escape: % & _ # $ { } ~ ^
tex <- function(x) {
  x <- gsub("\\\\", "\\\\textbackslash{}", x)
  x <- gsub("([%&_#$])", "\\\\\\1", x)
  x <- gsub("([{}])", "\\\\\\1", x)
  x <- gsub("~", "\\\\textasciitilde{}", x)
  x <- gsub("\\^", "\\\\textasciicircum{}", x)
  x
}

# --- a cadeia da Aula 01, sobre o corpus ---------------------------------
tokenizar <- function(texto) unlist(strsplit(tolower(texto), "\\s+"))
tokens <- lapply(docs, tokenizar)
tam    <- sapply(tokens, length)                 # tokens por documento
vocab  <- sort(unique(unlist(tokens)))
freq   <- sort(table(unlist(tokens)), decreasing = TRUE)

n_docs   <- length(docs)
n_pags   <- length(unique(origem))
n_vocab  <- length(vocab)
n_tokens <- sum(tam)

# --- os textos prontos para o \Sexpr -------------------------------------
texto_tam   <- paste0(min(tam), " a ", max(tam), " (m\\'edia ", round(mean(tam), 1), ")")
texto_top10 <- paste0("\\texttt{", tex(names(freq)[1:min(10, length(freq))]), "}", collapse = ", ")

# documentos por pagina, e quem domina
por_pag     <- sort(table(origem), decreasing = TRUE)
texto_dom   <- paste0("\\texttt{", tex(names(por_pag)[1]), "}: ", por_pag[1], " de ", n_docs,
                      " (", round(100 * por_pag[1] / n_docs), "\\%)")

# documentos curtos e longos demais (suspeitos de nao serem prosa)
curtos <- sum(tam < 20)
longos <- sum(tam > 300)
texto_extremos <- paste0(curtos, " com menos de 20 tokens; ", longos, " com mais de 300")

# sinais de sujeira: acentos, pontuacao grudada, digitos
tem_acento <- sum(grepl("[^ -~]", docs))
tem_pont   <- sum(grepl("[[:punct:]]", docs))
tem_dig    <- sum(grepl("[0-9]", docs))
texto_sujo <- paste0(tem_acento, " com acento, ", tem_pont, " com pontua\\c{c}\\~ao, ",
                     tem_dig, " com d\\'igitos (de ", n_docs, ")")

# tabela de origem
tab_origem <- data.frame(
  Pagina     = tex(names(por_pag)),
  Documentos = as.integer(por_pag),
  Tokens     = round(tapply(tam, origem, mean)[names(por_pag)], 1),
  row.names  = NULL
)
names(tab_origem) <- c("P\\'agina", "Documentos", "Tokens (m\\'edia)")
@

\selectlanguage{brazil}
\frenchspacing

